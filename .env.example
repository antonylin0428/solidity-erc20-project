# Sepolia Testnet Configuration
# Copy this file to .env and fill in your actual values

# Sepolia RPC URL (you can get this from Alchemy, Infura, or use a public endpoint)
# Public endpoint: https://ethereum-sepolia-rpc.publicnode.com
# Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
SEPOLIA_URL=https://ethereum-sepolia-rpc.publicnode.com

# Your wallet's private key (the one with Sepolia ETH)
# IMPORTANT: NEVER commit this file to git!
# IMPORTANT: Only use a test wallet, never your main wallet!
PRIVATE_KEY=your_private_key_here
